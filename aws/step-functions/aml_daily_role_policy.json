{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "RunEmrServerlessJobs",
      "Effect": "Allow",
      "Action": ["emr-serverless:StartJobRun", "emr-serverless:GetJobRun", "emr-serverless:CancelJobRun"],
      "Resource": ["arn:aws:emr-serverless:${region}:${account_id}:/applications/${emr_app_id}",
                   "arn:aws:emr-serverless:${region}:${account_id}:/applications/${emr_app_id}/jobruns/*"] },
    { "Sid": "PassTheJobRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "${emr_job_role_arn}",
      "Condition": { "StringEquals": { "iam:PassedToService": "emr-serverless.amazonaws.com" } } },
    { "Sid": "WaitForJobsSync",
      "Effect": "Allow",
      "Action": ["events:PutTargets", "events:PutRule", "events:DescribeRule"],
      "Resource": "arn:aws:events:${region}:${account_id}:rule/StepFunctionsGetEventsForEMRServerlessJobRule" },
    { "Sid": "RunLogInAthena",
      "Effect": "Allow",
      "Action": ["athena:StartQueryExecution", "athena:GetQueryExecution", "athena:GetQueryResults",
                 "athena:StopQueryExecution"],
      "Resource": "arn:aws:athena:${region}:${account_id}:workgroup/${athena_workgroup}" },
    { "Sid": "RunLogTableInGlue",
      "Effect": "Allow",
      "Action": ["glue:GetDatabase", "glue:GetTable", "glue:UpdateTable", "glue:GetPartitions"],
      "Resource": ["arn:aws:glue:${region}:${account_id}:catalog",
                   "arn:aws:glue:${region}:${account_id}:database/analytics",
                   "arn:aws:glue:${region}:${account_id}:table/analytics/pipeline_runs"] },
    { "Sid": "RunLogFilesAndQueryResults",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::${bucket}", "arn:aws:s3:::${bucket}/analytics/pipeline_runs/*",
                   "arn:aws:s3:::${bucket}/athena-results/*"] }
  ]
}
