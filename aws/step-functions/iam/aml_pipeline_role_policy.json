{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunJobs",
      "Effect": "Allow",
      "Action": ["emr-serverless:StartJobRun", "emr-serverless:GetJobRun", "emr-serverless:CancelJobRun"],
      "Resource": ["arn:aws:emr-serverless:us-east-1:390402569482:/applications/*"]
    },
    {
      "Sid": "PassJobRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::390402569482:role/aml-emr-serverless-job",
      "Condition": {"StringLike": {"iam:PassedToService": "emr-serverless.amazonaws.com"}}
    },
    {
      "Sid": "NestedPrepare",
      "Effect": "Allow",
      "Action": ["states:StartExecution"],
      "Resource": "arn:aws:states:us-east-1:390402569482:stateMachine:aml_prepare"
    },
    {
      "Sid": "NestedPrepareWait",
      "Effect": "Allow",
      "Action": ["states:DescribeExecution", "states:StopExecution"],
      "Resource": "arn:aws:states:us-east-1:390402569482:execution:aml_prepare:*"
    },
    {
      "Sid": "SyncRules",
      "Effect": "Allow",
      "Action": ["events:PutTargets", "events:PutRule", "events:DescribeRule"],
      "Resource": [
        "arn:aws:events:us-east-1:390402569482:rule/StepFunctionsGetEventsForEMRServerlessJobRule",
        "arn:aws:events:us-east-1:390402569482:rule/StepFunctionsGetEventsForStepFunctionsExecutionRule"
      ]
    },
    {
      "Sid": "EmitDataPrepared",
      "Effect": "Allow",
      "Action": "events:PutEvents",
      "Resource": "arn:aws:events:us-east-1:390402569482:event-bus/default"
    },
    {
      "Sid": "RunLogsMarkersModelPointer",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::is459-g1t4-aml/progress/prepare/*",
        "arn:aws:s3:::is459-g1t4-aml/progress/bq1/*",
        "arn:aws:s3:::is459-g1t4-aml/models/*"
      ]
    },
    {
      "Sid": "MissingKeyIsNoSuchKey",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::is459-g1t4-aml"
    },
    {
      "Sid": "Notify",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:390402569482:aml-bq1-alerts"
    }
  ]
}
